{
  "name": "PixKit — 图片与开发者工具",
  "short_name": "PixKit",
  "description": "图片压缩、证件照、格式转换，以及 JSON、时间戳、Base64 等开发者工具。全部在浏览器本地处理，文件不上传。",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#4f46e5",
  "categories": ["utilities", "productivity", "photo"],
  "icons": [
    {
      "src": "/assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "图片压缩",
      "short_name": "压缩",
      "url": "/tools/compress/",
      "icons": [{ "src": "/assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "证件照制作",
      "short_name": "证件照",
      "url": "/tools/idphoto/",
      "icons": [{ "src": "/assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "JSON 格式化",
      "short_name": "JSON",
      "url": "/tools/json/",
      "icons": [{ "src": "/assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "时间戳转换",
      "short_name": "时间戳",
      "url": "/tools/timestamp/",
      "icons": [{ "src": "/assets/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
