# Cloudflare Pages 响应头配置
# 文档：https://developers.cloudflare.com/pages/configuration/headers/
#
# 规则按从上到下匹配，更具体的要写在前面，否则会被通配规则吃掉。

# Service Worker 绝对不能缓存。它自己就是"更新的入口"，
# 一旦被缓存住，改了策略用户永远拿不到新版。
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# manifest 也走短缓存，改了图标和名字能及时生效
/manifest.webmanifest
  Cache-Control: public, max-age=3600

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# 静态资源：文件名没有 hash，不能设 immutable，缓存 1 天比较稳妥
/assets/*
  Cache-Control: public, max-age=86400

# HTML 必须每次校验，否则改了内容用户看不到
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
