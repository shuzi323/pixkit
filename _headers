# 响应头配置（Cloudflare Workers / Pages 通用，需放在静态资源根目录）
# 文档：https://developers.cloudflare.com/workers/static-assets/headers/
#
# 规则按从上到下匹配，更具体的要写在前面，否则会被通配规则吃掉。

# Service Worker 绝对不能缓存。它自己就是"更新的入口"，
# 一旦被缓存住，改了策略用户永远拿不到新版。
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# manifest 也走短缓存，改了图标和名字能及时生效
/manifest.webmanifest
  Cache-Control: public, max-age=3600

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# 静态资源：文件名带 ?v=内容哈希（构建时自动加），内容一变 URL 就变，
# 所以可以放心设一年 immutable —— 回访时这些请求一个都不会发出去。
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

# 图标例外：manifest 里写的是固定路径，没法带版本号。
# 设一年会导致换了图标用户一年看不到，所以只缓存 1 天。
/assets/icons/*
  Cache-Control: public, max-age=86400

# HTML 必须每次校验，否则改了内容用户看不到
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
